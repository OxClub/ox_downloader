    <string name="about_title">About</string>
    <string name="about_description">Universal Downloader inspects links you give it, finds the real downloadable files and saves them reliably with pause, resume, retries and background downloading.</string>
    <string name="about_legal">Only download content you are authorized to access. This app does not bypass DRM, paywalls, CAPTCHAs, logins or other access controls.</string>
